diff --git a/py-bindings/base/MotionValidator.cpp b/py-bindings/base/MotionValidator.cpp
index 56550ea..3245eb1 100644
--- a/py-bindings/base/MotionValidator.cpp
+++ b/py-bindings/base/MotionValidator.cpp
@@ -16,7 +16,14 @@ public:
     bool checkMotion(const ompl::base::State *s1, const ompl::base::State *s2,
                      std::pair<ompl::base::State *, double> &lastValid) const override
     {
-        return checkMotion(s1, s2);
+        if (checkMotion(s1, s2))
+            return true;
+        // Conservative valid prefix: s1 is assumed valid by OMPL's contract.
+        // Preserve the output entirely on success; report t=0 on failure.
+        if (lastValid.first)
+            si_->copyState(lastValid.first, s1);
+        lastValid.second = 0.0;
+        return false;
     }
 };
 void ompl::binding::base::init_MotionValidator(nb::module_ &m)
@@ -25,6 +32,15 @@ void ompl::binding::base::init_MotionValidator(nb::module_ &m)
         .def(nb::init<ompl::base::SpaceInformation *>())
         .def("checkMotion", nb::overload_cast<const ompl::base::State *, const ompl::base::State *>(
                                 &ompl::base::MotionValidator::checkMotion, nb::const_))
+        .def("checkMotionWithLastValid",
+             [](const ompl::base::MotionValidator &self, const ompl::base::State *s1,
+                const ompl::base::State *s2, ompl::base::State *output, double initialFraction)
+             {
+                 std::pair<ompl::base::State *, double> lastValid{output, initialFraction};
+                 bool valid = self.checkMotion(s1, s2, lastValid);
+                 return nb::make_tuple(valid, lastValid.second);
+             }, nb::arg("s1"), nb::arg("s2"), nb::arg("output").none(),
+             nb::arg("initial_fraction") = 1.0)
         .def("getValidMotionCount", &ompl::base::MotionValidator::getValidMotionCount)
         .def("getInvalidMotionCount", &ompl::base::MotionValidator::getInvalidMotionCount)
         .def("getCheckedMotionCount", &ompl::base::MotionValidator::getCheckedMotionCount)
